APP_ENV=development
APP_BASE_URL=http://localhost:3000
APP_TRUSTED_PROXY=true
LOG_LEVEL=info

DATABASE_URL=postgres://packetchat:packetchat_dev_password@postgres:5432/packetchat
REDIS_URL=redis://redis:6379

S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=packetchat
S3_SECRET_KEY=packetchat_dev_secret
S3_BUCKET_UPLOADS=packetchat-uploads
S3_BUCKET_EXPORTS=packetchat-exports
S3_BUCKET_ARTIFACTS=packetchat-artifacts
S3_FORCE_PATH_STYLE=true

COOKIE_SECURE=false
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_SECONDS=1209600
PASSWORD_RESET_TOKEN_TTL_SECONDS=3600
INVITE_TOKEN_TTL_SECONDS=604800

BOOTSTRAP_TOKEN=change-me-before-deploy
ENCRYPTION_KEY_BASE64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
JWT_SECRET=replace-with-long-random-jwt-secret

WORKER_CONCURRENCY=2
MAX_UPLOAD_BYTES=52428800
RATE_LIMIT_AUTH_PER_MINUTE=20
RATE_LIMIT_CHAT_PER_MINUTE=60
RATE_LIMIT_FILE_UPLOAD_PER_MINUTE=20

EMAIL_PROVIDER=manual
RESEND_API_KEY=
EMAIL_FROM=PacketChat <noreply@example.com>
EMAIL_SEND_TIMEOUT_MS=10000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_REJECT_UNAUTHORIZED=true
