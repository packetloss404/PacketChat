{
  "name": "packetchat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @packetchat/web",
    "dev:worker": "npm run dev -w @packetchat/worker",
    "build": "npm run build -w @packetchat/worker && npm run build -w @packetchat/web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"packages/**/*.test.ts\" \"apps/**/*.test.ts\"",
    "lint": "npm run lint:ts && npm run lint:js && npm run lint:workspaces",
    "lint:ts": "npm run typecheck",
    "lint:js": "node scripts/lint-js-syntax.mjs",
    "lint:workspaces": "npm run lint --workspaces --if-present",
    "verify": "npm run lint && npm run test",
    "prod:check": "npm run verify && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "compose:config": "docker compose --profile tools --env-file .env -f infrastructure/compose/docker-compose.yml config --quiet",
    "compose:build": "docker compose --env-file .env -f infrastructure/compose/docker-compose.yml build web worker migrate",
    "compose:check": "npm run compose:config && npm run compose:build",
    "db:migrate": "npm run migrate -w @packetchat/db",
    "compose:up": "docker compose --env-file .env -f infrastructure/compose/docker-compose.yml up -d --build",
    "compose:migrate": "docker compose --env-file .env -f infrastructure/compose/docker-compose.yml --profile tools run --build --rm migrate",
    "compose:down": "docker compose --env-file .env -f infrastructure/compose/docker-compose.yml down",
    "compose:logs": "docker compose --env-file .env -f infrastructure/compose/docker-compose.yml logs -f",
    "seed:demo": "node scripts/seed-demo.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "backup": "node scripts/backup.mjs all",
    "backup:postgres": "node scripts/backup.mjs postgres",
    "backup:minio": "node scripts/backup.mjs minio",
    "restore:check": "node scripts/restore-check.mjs",
    "test:integration": "node --import tsx --test \"**/*.integration.test.ts\""
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.787.0",
    "@node-rs/argon2": "^2.0.2",
    "bullmq": "^5.47.2",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.6.1",
    "jose": "^5.9.6",
    "next": "^15.5.18",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.3"
  },
  "overrides": {
    "fast-xml-builder": "^1.2.0",
    "postcss": "^8.5.26"
  },
  "devDependencies": {
    "@types/node": "^22.14.1",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  }
}
